# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Nexora Supabase (shared project qwaehqsmodekbgvnaavz) -----------------
# Supabase Dashboard → Project qwaehqsmodekbgvnaavz → Settings → API.
# The app refuses to boot against any other Supabase project.
VITE_SUPABASE_URL=https://qwaehqsmodekbgvnaavz.supabase.co
VITE_SUPABASE_ANON_KEY=PASTE_REAL_ANON_KEY_HERE

# --- Nexora universal auth storage key -------------------------------------
# The app pins its session storage to the shared Nexora key
# 'nexora.auth.qwaehqsmodekbgvnaavz' (PKCE + persistSession + autoRefresh +
# detectSessionInUrl). The constant is enforced in src/lib/supabase.ts; this
# line documents the value for ops and must never be changed to a different
# key, or cross-app session sharing would silently break.
VITE_SUPABASE_STORAGE_KEY=nexora.auth.qwaehqsmodekbgvnaavz
